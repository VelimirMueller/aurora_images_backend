# All settings are optional; defaults live in src/synthwerk_vision/config.py.
SYNTHWERK_CORS_ORIGINS=["http://localhost:5173"]
SYNTHWERK_UPLOAD_DIR=uploads
SYNTHWERK_DATA_DIR=data
# SYNTHWERK_ADMIN_TOKEN=  # set to enable /v1/labels and /v1/feedback
SYNTHWERK_MAX_UPLOAD_BYTES=5242880
SYNTHWERK_MAX_IMAGE_PIXELS=40000000
SYNTHWERK_BACKEND=siglip
SYNTHWERK_SIGLIP_DIR=models/siglip2-base-patch16-224
SYNTHWERK_LABEL_CACHE_DIR=models/label_cache
# mobilenet backend only:
# SYNTHWERK_MODEL_PATH=models/mobilenetv2-12.onnx
# SYNTHWERK_TAXONOMY_PATH=my-taxonomy.yaml
# Threads per ONNX Runtime session (0 = ORT default). Spinning is always off.
SYNTHWERK_ORT_THREADS=0
SYNTHWERK_TOP_K=5
SYNTHWERK_TOPIC_MIN_SCORE=0.05
SYNTHWERK_UNCERTAIN_BELOW=0.5
