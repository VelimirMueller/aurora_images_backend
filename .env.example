# All settings are optional; defaults live in src/aurorae_images/config.py.
AURORAE_CORS_ORIGINS=["http://localhost:5173"]
AURORAE_UPLOAD_DIR=uploads
AURORAE_DATA_DIR=data
# AURORAE_ADMIN_TOKEN=  # set to enable /v1/labels and /v1/feedback
AURORAE_MAX_UPLOAD_BYTES=5242880
AURORAE_MAX_IMAGE_PIXELS=40000000
AURORAE_BACKEND=siglip
AURORAE_SIGLIP_DIR=models/siglip2-base-patch16-224
AURORAE_LABEL_CACHE_DIR=models/label_cache
# mobilenet backend only:
# AURORAE_MODEL_PATH=models/mobilenetv2-12.onnx
# AURORAE_TAXONOMY_PATH=my-taxonomy.yaml
# Threads per ONNX Runtime session (0 = ORT default). Spinning is always off.
AURORAE_ORT_THREADS=0
AURORAE_TOP_K=5
AURORAE_TOPIC_MIN_SCORE=0.05
AURORAE_UNCERTAIN_BELOW=0.5
