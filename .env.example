# All settings are optional; defaults live in src/aurora_images/config.py.
AURORA_CORS_ORIGINS=["http://localhost:5173"]
AURORA_UPLOAD_DIR=uploads
AURORA_DATA_DIR=data
# AURORA_ADMIN_TOKEN=  # set to enable /v1/labels and /v1/feedback
AURORA_MAX_UPLOAD_BYTES=5242880
AURORA_MAX_IMAGE_PIXELS=40000000
AURORA_BACKEND=siglip
AURORA_SIGLIP_DIR=models/siglip2-base-patch16-224
AURORA_LABEL_CACHE_DIR=models/label_cache
# mobilenet backend only:
# AURORA_MODEL_PATH=models/mobilenetv2-12.onnx
# AURORA_TAXONOMY_PATH=my-taxonomy.yaml
# Threads per ONNX Runtime session (0 = ORT default). Spinning is always off.
AURORA_ORT_THREADS=0
AURORA_TOP_K=5
AURORA_TOPIC_MIN_SCORE=0.05
AURORA_UNCERTAIN_BELOW=0.5
